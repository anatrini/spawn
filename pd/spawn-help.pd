#N canvas 100 100 720 520 12;
#X text 20 15 spawn - run a command line and read what it prints, f 60;
#X text 20 60 1 Short commands, f 30;
#X msg 30 90 echo hello;
#X msg 130 90 pwd;
#X msg 180 90 ls;
#X msg 220 90 date;
#X text 330 60 2 A command that keeps running, f 32;
#X msg 340 90 ping -i 0.5 127.0.0.1;
#X msg 520 90 stop;
#X obj 30 170 spawn;
#X obj 30 220 print spawn;
#X floatatom 150 220 3 0 0 0 - - - 0;
#X text 190 220 1 while running;
#X text 30 250 output lines go to the Pd window, f 40;
#X text 20 300 The command runs through /bin/sh in the folder of the patch: quotes \, * \, > and && work as in a terminal. Programs outside /usr/bin and /bin need their full path \, for example the python of a conda or uv environment. In a message box \, a space inside a path is written with a backslash: Max\\ 9., f 85;
#X text 20 390 One command at a time per object. stop sends ctrl-C and ends the command after 3 s if it is still running. Deleting the object or closing the patch also stops it., f 85;
#X text 20 450 Left outlet: each line printed \, normal output and errors. Right outlet: 1 at the start \, 0 at the end., f 85;
#X text 20 490 On Windows the command runs through cmd.exe: try cd \, dir \, ping -t 127.0.0.1, f 85;
#X connect 2 0 9 0;
#X connect 3 0 9 0;
#X connect 4 0 9 0;
#X connect 5 0 9 0;
#X connect 7 0 9 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 9 1 11 0;
